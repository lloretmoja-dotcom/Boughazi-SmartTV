<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black">

    <!-- ===================== BIENVENIDA (solo botones) ===================== -->
    <LinearLayout
        android:id="@+id/welcomeSection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="48dp"
        android:visibility="visible">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:src="@drawable/app_logo"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginBottom="32dp" />

        <!-- Pantalla de solo botones: cada uno abre su propio panel
             aparte (con sus propias casillas), en vez de tener el
             correo y la contraseña compartidos a la vista de las tres
             acciones a la vez, que podía confundir. -->
        <Button
            android:id="@+id/welcomeEntrarBtn"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:text="Entrar"
            android:textAllCaps="false"
            android:backgroundTint="@color/accent_blue"
            android:layout_marginBottom="8dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusDown="@id/welcomeCrearCuentaBtn" />

        <Button
            android:id="@+id/welcomeCrearCuentaBtn"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:text="Crear cuenta nueva"
            android:textAllCaps="false"
            android:background="@drawable/text_button_selector"
            android:textColor="@color/accent_orange"
            android:layout_marginBottom="4dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@id/welcomeEntrarBtn"
            android:nextFocusDown="@id/welcomeOlvidoBtn" />

        <Button
            android:id="@+id/welcomeOlvidoBtn"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:text="¿Olvidaste tu contraseña?"
            android:textAllCaps="false"
            android:background="@drawable/text_button_selector"
            android:textColor="@color/muted_gray"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@id/welcomeCrearCuentaBtn" />
    </LinearLayout>

    <!-- ===================== PANEL: ENTRAR ===================== -->
    <LinearLayout
        android:id="@+id/loginPanelSection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="48dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Entrar"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <EditText
            android:id="@+id/loginEmail"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:hint="Correo de Gmail"
            android:inputType="textEmailAddress"
            android:textColor="@color/white"
            android:textColorHint="@color/muted_gray"
            android:padding="14dp"
            android:background="@drawable/input_background"
            android:layout_marginBottom="12dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusDown="@id/loginPassword" />

        <EditText
            android:id="@+id/loginPassword"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:hint="Contraseña"
            android:inputType="textPassword"
            android:textColor="@color/white"
            android:textColorHint="@color/muted_gray"
            android:padding="14dp"
            android:background="@drawable/input_background"
            android:layout_marginBottom="16dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@id/loginEmail"
            android:nextFocusDown="@id/loginSubmitBtn" />

        <Button
            android:id="@+id/loginSubmitBtn"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:text="Entrar"
            android:textAllCaps="false"
            android:backgroundTint="@color/accent_blue"
            android:layout_marginBottom="8dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@id/loginPassword"
            android:nextFocusDown="@id/loginBackBtn" />

        <Button
            android:id="@+id/loginBackBtn"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:text="Volver"
            android:textAllCaps="false"
            android:background="@drawable/text_button_selector"
            android:textColor="@color/muted_gray"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@id/loginSubmitBtn" />

        <TextView
            android:id="@+id/loginError"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:textColor="@color/error_red"
            android:layout_marginTop="8dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ===================== PANEL: CREAR CUENTA NUEVA ===================== -->
    <LinearLayout
        android:id="@+id/signUpPanelSection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="48dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Crear cuenta nueva"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <EditText
            android:id="@+id/signUpEmail"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:hint="Correo de Gmail"
            android:inputType="textEmailAddress"
            android:textColor="@color/white"
            android:textColorHint="@color/muted_gray"
            android:padding="14dp"
            android:background="@drawable/input_background"
            android:layout_marginBottom="12dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusDown="@id/signUpPassword" />

        <EditText
            android:id="@+id/signUpPassword"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:hint="Contraseña (mínimo 6 caracteres)"
            android:inputType="textPassword"
            android:textColor="@color/white"
            android:textColorHint="@color/muted_gray"
            android:padding="14dp"
            android:background="@drawable/input_background"
            android:layout_marginBottom="16dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@id/signUpEmail"
            android:nextFocusDown="@id/signUpSubmitBtn" />

        <Button
            android:id="@+id/signUpSubmitBtn"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:text="Crear cuenta"
            android:textAllCaps="false"
            android:backgroundTint="@color/accent_orange"
            android:layout_marginBottom="8dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@id/signUpPassword"
            android:nextFocusDown="@id/signUpBackBtn" />

        <Button
            android:id="@+id/signUpBackBtn"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:text="Volver"
            android:textAllCaps="false"
            android:background="@drawable/text_button_selector"
            android:textColor="@color/muted_gray"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@id/signUpSubmitBtn" />

        <TextView
            android:id="@+id/signUpError"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:textColor="@color/error_red"
            android:layout_marginTop="8dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ===================== PANEL: OLVIDÉ MI CONTRASEÑA ===================== -->
    <LinearLayout
        android:id="@+id/forgotPanelSection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="48dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿Olvidaste tu contraseña?"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:text="Escribe tu correo y te mandamos un enlace para cambiarla."
            android:textColor="@color/muted_gray"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <EditText
            android:id="@+id/forgotEmail"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:hint="Correo de Gmail"
            android:inputType="textEmailAddress"
            android:textColor="@color/white"
            android:textColorHint="@color/muted_gray"
            android:padding="14dp"
            android:background="@drawable/input_background"
            android:layout_marginBottom="16dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusDown="@id/forgotSubmitBtn" />

        <Button
            android:id="@+id/forgotSubmitBtn"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:text="Enviar enlace"
            android:textAllCaps="false"
            android:backgroundTint="@color/accent_blue"
            android:layout_marginBottom="8dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@id/forgotEmail"
            android:nextFocusDown="@id/forgotBackBtn" />

        <Button
            android:id="@+id/forgotBackBtn"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:text="Volver"
            android:textAllCaps="false"
            android:background="@drawable/text_button_selector"
            android:textColor="@color/muted_gray"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@id/forgotSubmitBtn" />

        <TextView
            android:id="@+id/forgotError"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:textColor="@color/error_red"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/forgotStatus"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ===================== CÓDIGO DE ACTIVACIÓN ===================== -->
    <LinearLayout
        android:id="@+id/codeSection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="48dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Introduce tu código de activación"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:text="Te lo ha dado la persona que activó tu televisión. Solo hace falta la primera vez."
            android:textColor="@color/muted_gray"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <EditText
            android:id="@+id/codeInput"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:hint="Código"
            android:inputType="textCapCharacters"
            android:textColor="@color/white"
            android:textColorHint="@color/muted_gray"
            android:padding="14dp"
            android:background="@drawable/input_background"
            android:layout_marginBottom="16dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusDown="@id/codeSubmitBtn" />

        <Button
            android:id="@+id/codeSubmitBtn"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:text="Activar"
            android:textAllCaps="false"
            android:backgroundTint="@color/accent_orange"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@id/codeInput" />

        <TextView
            android:id="@+id/codeError"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:textColor="@color/error_red"
            android:layout_marginTop="8dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ===================== PANTALLA PRINCIPAL (TV) ===================== -->
    <FrameLayout
        android:id="@+id/mainSection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:use_controller="false"
            app:resize_mode="fill" />

        <!-- Categorías (izquierda) -->
        <LinearLayout
            android:id="@+id/categoriesColumn"
            android:layout_width="220dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#CC0B0E14"
            android:visibility="gone">

            <!-- Aviso de diagnóstico: cuántos canales/países se han
                 cargado de verdad. Fijo (no desaparece solo), en el
                 mismo sitio de siempre para no perdérselo. -->
            <TextView
                android:id="@+id/debugInfoText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFEB3B"
                android:padding="10dp"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="14sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/categoriesList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingTop="24dp" />
        </LinearLayout>

        <!-- Canales de la categoría elegida -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/channelsList"
            android:layout_width="280dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:layout_marginStart="220dp"
            android:background="#B30B0E14"
            android:paddingTop="24dp"
            android:visibility="gone" />

        <!-- OSD: aviso flotante al cambiar de canal -->
        <LinearLayout
            android:id="@+id/osdContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#D0121620"
            android:padding="16dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/osdLogo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="16dp" />

            <TextView
                android:id="@+id/osdNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent_orange"
                android:textSize="26sp"
                android:textStyle="bold"
                android:layout_marginEnd="16dp" />

            <TextView
                android:id="@+id/osdName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="22sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/loadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Cargando canales…"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:visibility="gone" />

        <!-- Franja de publicidad, siempre visible abajo del todo -->
        <FrameLayout
            android:id="@+id/adContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#0B0E14" />
    </FrameLayout>

</FrameLayout>
